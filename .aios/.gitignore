# Local, per-machine, never committed. Shipped as part of the package so an upgrade can add
# new ignore rules without touching your root .gitignore, which is yours to edit.
backups/
txn.json
usage/
local-operator.json
core_bridge/instance.json
core_bridge/reports/
# the daily release-notice check's one-line cache
release_notice.json
# the install tool's own lock while an upgrade or rollback runs, and the guard around it
lock
guard
